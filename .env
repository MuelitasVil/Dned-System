# --- Base de Datos MySQL ---
MYSQL_ROOT_PASSWORD=root_secure_password_change_me
MYSQL_DATABASE=dned_system_db
MYSQL_USER=dned_user
MYSQL_PASSWORD=dned_user_password_change_me

# --- BackEnd Organizacional ---
SECRET_KEY=cambia_esta_llave_secreta_por_algo_muy_seguro
WORKSPACE_MANAGER_URL=http://backend-gam:8000

# --- BackEnd GAM ---
# Nota: Las rutas apuntan al volumen persistente definido en el docker-compose
GAM_WORKDIR=/var/lib/gam/work
GAMCFGDIR=/var/lib/gam/config